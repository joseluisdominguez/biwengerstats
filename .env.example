# Configuración del bot para desarrollo local.
# Copia este fichero a `.env` y rellena los valores. `.env` está en .gitignore.
#
# En GitHub Actions estos valores llegan como secrets en forma de variables de entorno
# reales: el .env NO las pisa nunca (ver load_dotenv en bot.py), así que es seguro
# tener un .env local apuntando al Sheet de desarrollo.

# --- Biwenger ---
# Token Bearer de la API. Se obtiene de las peticiones del navegador en biwenger.as.com.
BIWENGER_BEARER_TOKEN=
# ID de la liga
BIWENGER_LEAGUE_ID=
# ID de usuario (se envía en la cabecera X-User)
BIWENGER_USER_ID=

# Competición. Por defecto la-liga.
# BIWENGER_COMPETITION=la-liga

# Solo para redes con proxy corporativo: 1 desactiva la verificación TLS.
# BIWENGER_SKIP_SSL_VERIFY=0

# --- Google Sheets ---
# ID del Sheet, de la URL de edición: docs.google.com/spreadsheets/d/<ID>/edit
# En local conviene apuntar al Sheet de DESARROLLO, no al de producción.
GOOGLE_SHEET_ID=
# Ruta al JSON de la cuenta de servicio. El Sheet debe estar compartido con su
# client_email como Editor.
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# --- Solo para ejecuciones puntuales ---
# ID de una jornada concreta (ej. 4899). Si se omite, el bot procesa todas las
# jornadas disputadas de la temporada en curso que falten en el Sheet.
# JORNADA=
